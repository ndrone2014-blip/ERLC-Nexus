# =====================================================================
#  ERLC Nexus configuration
#  install.bat copies this file to config.env (it never overwrites an
#  existing config.env). Edit config.env — never share it publicly.
# =====================================================================

# ---------------------------------------------------------------------
#  Discord  (https://discord.com/developers/applications)
# ---------------------------------------------------------------------
# Bot tab -> Reset Token. Keep this secret.
DISCORD_BOT_TOKEN=
# General Information -> Application ID
DISCORD_APPLICATION_ID=
# OAuth2 -> Client Secret (used for "Sign in with Discord" on the website)
DISCORD_CLIENT_SECRET=
# Your Discord server ID (right-click server icon -> Copy Server ID, Developer Mode on).
# Commands appear instantly in this server, and roles are read from it.
DISCORD_GUILD_ID=
# Leave empty to use http://localhost:8420/auth/callback (add the same URL in OAuth2 -> Redirects).
DISCORD_REDIRECT_URI=

# ---------------------------------------------------------------------
#  ERLC / PRC API  (https://apidocs.erlc.gg)
# ---------------------------------------------------------------------
# In-game: Settings -> ER:LC API (needs the ERLC API server pack). You can also
# set it later from the website: System -> API Configuration.
ERLC_SERVER_KEY=
# Only for public applications serving many servers. Leave empty.
ERLC_GLOBAL_KEY=
ERLC_API_BASE_URL=https://api.erlc.gg
# Seconds between syncs (minimum 10). One request per sync fetches everything.
ERLC_SYNC_INTERVAL=20
ERLC_CACHE_TTL=15
# Optional signed event webhooks (needs a public HTTPS URL; most local installs leave this off).
ERLC_WEBHOOK_ENABLED=false

# ---------------------------------------------------------------------
#  Website
# ---------------------------------------------------------------------
# 127.0.0.1 = only this computer. Use 0.0.0.0 to allow other devices on your network.
WEB_HOST=127.0.0.1
WEB_PORT=8420
# Public address if you put Nexus behind a domain / reverse proxy, e.g. https://cad.example.com
PUBLIC_URL=
# Long random value. install.bat generates one automatically. Changing it signs everyone out
# and makes a dashboard-saved ERLC key unreadable (re-enter it).
SECRET_KEY=change-me
SESSION_HOURS=12
# Set to true when the site is served over HTTPS.
COOKIE_SECURE=false
# true when a tunnel / reverse proxy on THIS computer forwards visitors (start-online sets it
# automatically). Uses CF-Connecting-IP / X-Forwarded-For only for requests from 127.0.0.1.
TRUST_PROXY=false
# Lets this computer sign in as INITIAL_ADMIN_DISCORD_ID without Discord (for first-time setup).
# Turn OFF once Discord login works.
DEV_LOGIN=false

# ---------------------------------------------------------------------
#  Platform
# ---------------------------------------------------------------------
# Your Discord user ID. This account is made Owner automatically.
INITIAL_ADMIN_DISCORD_ID=
# Leave empty for the built-in SQLite database (data/nexus.db).
# PostgreSQL example: postgresql+asyncpg://user:password@localhost:5432/nexus
DATABASE_URL=
LOG_LEVEL=INFO

# ---------------------------------------------------------------------
#  Public link (start-online.bat)
# ---------------------------------------------------------------------
# Leave both empty for a free quick link (changes every start).
# For a permanent link: the token of a tunnel from the Cloudflare dashboard, and set PUBLIC_URL
# above to its https:// address. See docs/DEPLOYMENT.md "A permanent link". Keep it secret.
TUNNEL_TOKEN=
# Full path to cloudflared(.exe) if you installed it yourself (otherwise found/downloaded automatically).
CLOUDFLARED_PATH=
